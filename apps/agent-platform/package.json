{
  "name": "agent-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Learning project: an explicit, framework-free agent runtime.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "ajv": "8.20.0"
  }
}
