# Copy to .env (gitignored). Read by both `npm run dev` and `docker compose up`.

# stub (no API key needed) | anthropic
LLM_PROVIDER=stub

# Required when LLM_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=

# Optional Anthropic settings (defaults shown).
# ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
# ANTHROPIC_EFFORT=medium

# debug additionally logs the full payload of every LLM request.
# LOG_LEVEL=info

# Web pages allowed to open the realtime WebSocket (/realtime): comma-separated origins.
# Default: http://localhost:<PORT>,http://127.0.0.1:<PORT>. Clients that aren't browsers
# (like `npm run chat`) send no Origin and are always allowed: this is not authentication.
# ALLOWED_ORIGINS=

# Background task worker: coding (default) | simulated
# TASK_WORKER=coding
# Where task workspaces live with `npm run dev` (docker compose sets its own).
# WORKSPACES_DIR=./workspaces
# Let the coding worker run commands in Docker sandbox containers: none (default) | docker
# SANDBOX=none
# SANDBOX_IMAGE=node:24-slim
# none (default) | bridge (bridge is needed for `npm install` from the registry)
# SANDBOX_NETWORK=none

# Repositories tasks may work on (the model picks one by name): name=url or name=url#baseBranch,
# comma-separated. Never put credentials in the URL.
# REPOSITORIES=playground=https://github.com/aheua10/playground.git
# Token for cloning private repositories and pushing (a fine-grained GitHub token limited to
# those repositories, with Contents: read & write). Only the host-side git commands see it.
# GIT_TOKEN=
# Let publish_task push a finished task's branch (agent/<taskId>) to its repository.
# ALLOW_GIT_PUSH=false
